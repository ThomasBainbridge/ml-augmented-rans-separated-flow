FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// k = 1.5*(I*Ubar)^2 with I~5%, Ubar=0.020188  ->  ~1.5e-6.

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1.5e-6;

boundaryField
{
    "(inlet|outlet)"
    {
        type            cyclic;
    }
    defaultFaces
    {
        type            empty;
    }
    "(bottomWall|topWall)"
    {
        type            kqRWallFunction;
        value           $internalField;
    }
}


