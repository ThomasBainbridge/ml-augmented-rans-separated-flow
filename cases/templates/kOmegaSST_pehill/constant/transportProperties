FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel  Newtonian;

// Matches the provided DNS meshes: nu = 5e-6, Ubar = 0.020188, H = 1
// (Re_H = 5600 for the Xiao et al. 2020 database).
nu              5e-06;


