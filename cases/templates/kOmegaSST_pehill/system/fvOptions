FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Maintain the target bulk velocity over the whole domain, matching the
// operating point of the provided DNS meshes (pressureGradientExplicitSource
// with Ubar = 0.020188 in the original OpenFOAM.org cases). meanVelocityForce
// is the v2312 equivalent.
momentumSource
{
    type            meanVelocityForce;
    selectionMode   all;
    fields          (U);
    Ubar            (0.020188 0 0);
}


