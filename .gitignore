# ---------------------------------------------------------------------------
# Data: reference DNS and derived data are large and re-downloadable.
# Do NOT commit raw DNS/RANS data by default.
# ---------------------------------------------------------------------------
data/external/
data/processed/
!data/external/.gitkeep
!data/processed/.gitkeep

# ---------------------------------------------------------------------------
# Results: regenerated by scripts. Keep the folders, ignore the artefacts.
# (Selected final figures can be force-added with `git add -f`.)
# ---------------------------------------------------------------------------
results/figures/*
results/tables/*
!results/figures/.gitkeep
!results/tables/.gitkeep

# ---------------------------------------------------------------------------
# OpenFOAM run artefacts: keep the case definition (0.orig, constant, system,
# Allrun/Allclean), ignore everything a run generates.
# ---------------------------------------------------------------------------
cases/*/0/
cases/*/[1-9]*/
cases/*/0.[0-9]*/
cases/*/processor*/
cases/*/postProcessing/
cases/*/VTK/
cases/*/constant/polyMesh/
cases/*/dynamicCode/
# Generated multi-geometry run cases (built from external meshes by
# scripts/run_ml_cases.sh); the template under cases/templates/ is tracked.
cases/ml_runs/
cases/*/log.*
cases/*/*.foam
cases/*/*.OpenFOAM

# ---------------------------------------------------------------------------
# OpenFOAM custom-solver build artefacts (keep the source, ignore the build)
# ---------------------------------------------------------------------------
src/solvers/*/Make/linux*/
src/solvers/*/lnInclude/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
*.swp
.vscode/
.idea/

# large data archives (extracted into data/external/)
*.zip
